# RTI-GPT — Environment Variables
# Copy this file to .env.local and fill in the real values.
# NEVER commit .env.local to git.

# ── Anirudhan: Groq API (Whisper STT) ────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Anirudhan: Google Gemini API (Entity Extraction) ─────────────────────────
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here

# ── Bibin/Anirudhan: Supabase (Telemetry DB) ─────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Deepan: Feature flag (set to 'true' when backend is ready) ────────────────
# This is also toggled in src/components/InputWizard.tsx (USE_REAL_API constant)
NEXT_PUBLIC_USE_REAL_API=false
